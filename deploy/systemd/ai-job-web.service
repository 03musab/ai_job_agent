[Unit]
Description=AI Job Agent - Web Gunicorn Service
After=network.target redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai_job_agent
EnvironmentFile=/home/ubuntu/ai_job_agent/.env
ExecStart=/home/ubuntu/ai_job_agent/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 --timeout 120 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
