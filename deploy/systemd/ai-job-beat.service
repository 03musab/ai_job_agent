[Unit]
Description=AI Job Agent - Celery Beat Scheduler Service
After=network.target redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai_job_agent
EnvironmentFile=/home/ubuntu/ai_job_agent/.env
ExecStart=/home/ubuntu/ai_job_agent/venv/bin/celery -A app.celery beat --loglevel=info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
