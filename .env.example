# ===================================================================
# AI JobSnap — Complete Production Environment Configuration
# ===================================================================
# Copy this file to .env and fill in your actual production keys.
# NEVER commit .env to version control!
# ===================================================================

# -------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY
# -------------------------------------------------------------------
# Mandatory: 64-char random string for session cryptographic signing.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-64-char-string

# Environment: 'production' or 'development'
FLASK_ENV=production

# Debug mode: Set to False in production
DEBUG=False
FLASK_DEBUG=False

# Port to bind (auto-injected by Render/Railway/Heroku via $PORT)
PORT=5000

# Public canonical URL of your deployed application (used for email & invite links)
PUBLIC_APP_URL=https://app.jobsnap.me

# -------------------------------------------------------------------
# 1B. GOOGLE OAUTH 2.0 (SIGN IN WITH GOOGLE)
# -------------------------------------------------------------------
# Create Web Application credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://app.jobsnap.me/auth/google/callback

# -------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# -------------------------------------------------------------------
# SQLite default: sqlite:///learning_paths.db
# PostgreSQL (Production): postgresql://user:password@hostname:5432/dbname
# Note: app.py automatically converts legacy postgres:// to postgresql://
DATABASE_URL=sqlite:///learning_paths.db

# Optional migration toggle: set to true to run one-off job hash migration on boot
RUN_JOB_HASH_MIGRATION=false

# -------------------------------------------------------------------
# 3. REDIS & CELERY ASYNCHRONOUS TASK QUEUE
# -------------------------------------------------------------------
# In Render/Railway: REDIS_URL is provided by managed Redis plugin.
# In Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional gevent patch toggle for async networking
ENABLE_GEVENT_PATCH=false

# -------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & LLM API KEYS
# -------------------------------------------------------------------
# Google Gemini API key for resume parsing, skills extraction, interview prep
# Get free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Cerebras Cloud SDK (Ultra-fast LLM inference fallback)
# Get from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------------------
# 5. EXTERNAL SERVICES & NEWS FEEDS
# -------------------------------------------------------------------
# NewsAPI key for industry news, tech hiring insights, and market trends
# Get from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# -------------------------------------------------------------------
# 6. EMAIL & SYSTEM NOTIFICATIONS (SMTP)
# -------------------------------------------------------------------
# Email credentials for sending alerts, verification, and outreach digests
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password_here

# Admin email recipient for critical system errors / crash alerts
ADMIN_ALERT_EMAIL=admin@yourdomain.com

# -------------------------------------------------------------------
# 7. ADMIN SECURITY
# -------------------------------------------------------------------
# Secret token required to upload bulk company logos or system datasets
ADMIN_UPLOAD_PASS=set_a_secure_admin_password_here

# -------------------------------------------------------------------
# 8. SCRAPING ENGINE & WORKER TUNING
# -------------------------------------------------------------------
# Enable Selenium browser automation (requires Edge/Chrome driver installed)
# In lightweight container hosting without headless browser, keep false (uses HTTP/BS4)
ENABLE_SELENIUM=false

# Path to Edge/Chrome driver if ENABLE_SELENIUM=true
EDGE_DRIVER_PATH=

# Max concurrent workers for job scraping and LinkedIn enrichment
SCRAPE_MAX_WORKERS=5
LINKEDIN_DETAIL_MAX_WORKERS=3

# Minimum relevance score threshold (0.0 to 1.0) for job matching
RELEVANCE_MIN_THRESHOLD=0.4
