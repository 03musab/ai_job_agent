# ===================================================================
# AI JobSnap — Production Environment Configuration Blueprint
# ===================================================================

# Flask & Core Security
SECRET_KEY=change-me-to-a-secure-random-64-char-string
FLASK_ENV=production
DEBUG=False
PORT=5000

# Database (Defaults to SQLite; specify postgresql:// for production)
DATABASE_URL=sqlite:///jobs.db

# Redis / Celery Task Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI & LLM Providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Mail & System Outbox
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
